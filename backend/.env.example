# GCP Configuration
VISIONQA_GCP_PROJECT_ID=your-gcp-project-id
VISIONQA_GCP_REGION=us-central1

# Firestore
VISIONQA_FIRESTORE_DATABASE=(default)

# Cloud Storage
VISIONQA_GCS_BUCKET=visionqa-artifacts

# Gemini API Key (get one at https://aistudio.google.com/apikey)
# Set this for local development. For production, use Vertex AI with ADC instead.
VISIONQA_GOOGLE_API_KEY=

# Local development mode
# Set to 'true' for local dev (uses in-memory DB + local file storage)
# Set to 'false' for production (uses Firestore + Cloud Storage)
VISIONQA_LOCAL_MODE=true

# Gemini Models
VISIONQA_GEMINI_MODEL=gemini-2.0-flash
VISIONQA_GEMINI_VISION_MODEL=gemini-2.0-flash

# Auth
VISIONQA_JWT_SECRET=your-secret-key-change-in-production

# CORS
VISIONQA_FRONTEND_URL=http://localhost:3000

# Server
VISIONQA_HOST=0.0.0.0
VISIONQA_PORT=8000
